# --- Entra App Registration credentials ---
# Create an app registration in https://entra.microsoft.com -> Identity -> App registrations -> New registration.
# Then grant it these Microsoft Graph APPLICATION permissions (not delegated), and click "Grant admin consent":
#   DeviceManagementConfiguration.Read.All   (required, all policy types + assignment filters)
#   Group.Read.All                           (required, group names + dynamic membership rules)
#   DeviceManagementServiceConfig.Read.All   (optional, needed for Windows Autopilot deployment profiles)
#   DeviceManagementScripts.Read.All         (optional, needed for Platform Scripts -- Windows PowerShell + macOS shell)
#
# Granting admin consent needs a Global Administrator (or Privileged Role / Cloud Application /
# Application Administrator) -- an Intune Administrator alone cannot consent to app permissions.
#
# Docs: https://learn.microsoft.com/en-us/graph/permissions-reference
#
# Then create a client secret under "Certificates & secrets" and paste it below.

TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=

# Port the server listens on
PORT=4000

# How long (seconds) to cache Graph responses in memory before re-fetching
CACHE_TTL_SECONDS=300

# Optional: comma-separated list of browser origins allowed to call the API.
# Only needed if you serve the web UI from a different host/port than the
# defaults below (dev proxy and the Docker build are already same-origin).
# CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
